[submodule "lib/mxml"]
	path = lib/mxml
	url = https://github.com/segabl/mxml.git
[submodule "lib/wren"]
	path = lib/wren
	url = https://github.com/munificent/wren.git
[submodule "lib/sys/zlib"]
	path = lib/sys/zlib
	url = https://github.com/zlib-ng/zlib-ng.git
[submodule "lib/sys/curl"]
	path = lib/sys/curl
	url = https://github.com/curl/curl.git
[submodule "lib/luajit"]
	path = lib/luajit
	url = https://github.com/LeonTheo02/LuaJIT.git
[submodule "lib/safetyhook"]
	path = lib/safetyhook
	url = https://github.com/cursey/safetyhook.git
[submodule "lib/zydis"]
	path = lib/zydis
	url = https://github.com/zyantific/zydis.git
[submodule "lib/sys/libpsl"]
	path = lib/sys/libpsl
	url = https://github.com/rockdaboot/libpsl.git
[submodule "lib/sys/psl-list"]
	path = lib/sys/psl-list
	url = https://github.com/publicsuffix/list.git
